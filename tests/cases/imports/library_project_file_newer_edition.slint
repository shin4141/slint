//edition: 1.18

// An application of edition 1.18 that uses a library of edition 1.19:
// each component keeps the language behavior of its own edition.

//library_path(new_lib): ../../helper_components/edition_1_19_library/slint-project.json
import { RepeatedText, Slot, StatesOnly } from "@new_lib";

component AppRepeatedText inherits Rectangle {
    if true: Text { text: "foo"; }
}

component AppStatesOnly inherits Rectangle {
    width: 100px;
    height: 100px;
    in property <bool> moved;
    out property <length> inner-x: inner.x;
    inner := Rectangle {
        width: 40px;
        height: 20px;
        states [
            moved when moved: { x: 5px; }
        ]
    }
}

export component TestCase inherits Window {
    width: 100px;
    height: 100px;

    // From edition 1.19, an `if` child counts toward its parent's size (#407).
    lib-text := RepeatedText { }
    app-text := AppRepeatedText { }
    slot := Slot {
        if true: Text { text: "foo"; }
    }
    out property <bool> lib-text-counts: lib-text.min-height > 0px;
    out property <bool> app-text-ignored: app-text.min-height == 0px;
    out property <bool> slot-text-ignored: slot.min-height == 0px;

    // From edition 1.19, an `x` that only states set keeps centering the element (#8852).
    lib-states := StatesOnly { }
    app-states := AppStatesOnly { }
    out property <length> lib-states-x: lib-states.inner-x;
    out property <length> app-states-x: app-states.inner-x;

    out property <bool> test: lib-text-counts && app-text-ignored && slot-text-ignored
        && lib-states-x == 30px && app-states-x == 0px;
}

/*
```rust
let instance = TestCase::new().unwrap();
assert!(instance.get_test());
```

```cpp
auto handle = TestCase::create();
const TestCase &instance = *handle;
assert(instance.get_test());
```

```js
var instance = new slint.TestCase({});
assert(instance.test);
```

```python
instance = TestCase()
assert instance.test
```
*/
